# Create a NEW Telegram bot token with @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Optional official Clash of Clans developer API token. Keep it private; the
# key may be restricted to the server's public IP address.
COC_API_TOKEN=

# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before users can securely save AI provider keys.
AI_KEY_ENCRYPTION_KEY=

# Shared default AI key: users without a personal key use this OpenRouter account.
# Personal keys replace this default only for their own Telegram account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/space-bunny-alpha
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLite database path (relative paths are resolved from the project root).
DATABASE_PATH=data/bot.sqlite3

# Optional Telegram group/channel ID for support-ticket notifications.
SUPPORT_CHAT_ID=

# Default interval (minutes, 5-1440) between automatic war reminders in linked groups.
WAR_REMINDER_INTERVAL_MINUTES=60

# Arabic is the default interface language.
DEFAULT_LANGUAGE=ar
