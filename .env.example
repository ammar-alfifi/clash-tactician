# ── مطلوب ──────────────────────────────────────────────────────────────
# رمز بوت تيليجرام من @BotFather. أنشئ رمزًا جديدًا ولا تضعه في Git.
TELEGRAM_BOT_TOKEN=

# ── بيانات اللعبة (Clash of Clans API الرسمية) ──────────────────────────
# مفتاح مطوّر Supercell. يُقيّد غالبًا بعنوان IP الخادم؛ حدّثه من لوحة المطورين
# عند تغيّر IP. راجع /diag?token=...&current=1 لمعرفة IP الحالي.
COC_API_TOKEN=
# COC_BASE_URL=https://api.clashofclans.com/v1
# COC_CACHE_SECONDS=300
# COC_TIMEOUT_SECONDS=20

# ── الذكاء الاصطناعي ───────────────────────────────────────────────────
# ولّد مفتاح التشفير محليًا:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# مطلوب لحفظ مفاتيح المستخدمين الشخصية بشكل آمن.
AI_KEY_ENCRYPTION_KEY=

# مفتاح NVIDIA NIM المشترك (موصى به: نماذج رؤية بطبقة تجريبية مجانية).
# أنشئ مفتاحًا من https://build.nvidia.com/settings
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FALLBACK_MODELS=meta/muse-glimmer-30b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=180
# نموذج نصي قوي لبناء الخطة من وصف القاعدة (لا يرى الصورة، سريع جدًا ~10 ثوان)
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b

# مفتاح OpenRouter (يوجّه لنماذج رؤية مجانية موثوقة، ويُستخدم أولاً في السباق).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,thinkingmachines/inkling:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_TIMEOUT_SECONDS=120
# MAX_IMAGE_BYTES=8388608

# ── التشغيل ────────────────────────────────────────────────────────────
# مسار قاعدة SQLite (المسارات النسبية تُحسب من جذر المشروع).
DATABASE_PATH=data/bot.sqlite3

# معرّفات المشرفين (مفصولة بفواصل) — لوحة الإدارة والبث.
ADMIN_IDS=

# قناة/مجموعة استقبال تذاكر الدعم.
SUPPORT_CHAT_ID=

# تذكيرات الحرب التلقائية في المجموعات المرتبطة.
WAR_REMINDER_INTERVAL_MINUTES=60
# REMINDER_TICK_SECONDS=60
# ENABLE_BACKGROUND_JOBS=true

# لغة الواجهة الافتراضية.
DEFAULT_LANGUAGE=ar

# رمز حماية نقطة التشخيص /diag.
DIAG_TOKEN=

# منفذ خادم الصحة (تستخدمه منصات الاستضافة).
# PORT=8080

# ── نسخ احتياطي إلى مستودع Git خاص (اختياري) ─────────────────────────────
# BACKUP_GIT_REMOTE=git@github.com:USER/clash-tactician-data.git
# BACKUP_SSH_KEY=<base64-encoded write-only deploy key>
# BACKUP_INTERVAL_SECONDS=900
